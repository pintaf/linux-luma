# SC7280/QCM6490 (kodiak) family fragment. The base luma.fragment is not
# present at 497791a; carry the generic Luma options here until it lands.
# These are the SoC, the display/media stack and the Fairphone 5 drivers.
# Subsystem roots (SND/DRM/MEDIA) will move to luma.fragment when it lands.

# Generic Luma options normally supplied by the base luma.fragment.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_AUDIT=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY_SELINUX=y
# CONFIG_DEFAULT_SECURITY_DAC is not set
CONFIG_SECURITY_SELINUX_DEVELOP=y
# CONFIG_SECURITY_SELINUX_BOOTPARAM is not set
CONFIG_ARCH_QCOM=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_V3=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_HW_RANDOM=y
CONFIG_INTERCONNECT=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SC7280=y
CONFIG_SPMI=y
CONFIG_TEE=y
CONFIG_OPTEE=y

# Sound
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_QCOM_COMMON=m
CONFIG_SND_SOC_QDSP6=y
CONFIG_SND_SOC_SM8250=m
CONFIG_SND_SOC_AW88261=y
CONFIG_SND_SOC_WCD938X_SDW=y
CONFIG_SND_SOC_LPASS_RX_MACRO=y
CONFIG_SND_SOC_LPASS_TX_MACRO=y
CONFIG_SND_SOC_LPASS_VA_MACRO=y
CONFIG_SOUNDWIRE=y
CONFIG_SOUNDWIRE_QCOM=y

CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_DISPLAY_DP_AUX_BUS=y
# Display and GPU
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_RAYDIUM_RM692E5=y

# Camera
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_QCOM_CAMSS=y
CONFIG_VIDEO_IMX800=y
CONFIG_VIDEO_IMX858=y
CONFIG_VIDEO_S5KJN1=y
CONFIG_I2C_QCOM_CCI=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y

# Touch
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_CORE=y
CONFIG_TOUCHSCREEN_GOODIX_BERLIN_SPI=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_I2C_QCOM_GENI=y

# Wi-Fi (WCN6750)
CONFIG_ATH11K=y
CONFIG_ATH11K_AHB=m

# SoC drivers
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_APR=y
CONFIG_QCOM_BAM_DMA=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_GENI_SE=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_QCOM_ICC_BWMON=y
CONFIG_QCOM_IOMMU=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_QCOM_Q6V5_ADSP=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_QSEECOM=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_STATS=y
CONFIG_QCOM_SYSMON=y
CONFIG_QCOM_WDT=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_REMOTEPROC=y
CONFIG_RPMSG_QCOM_GLINK_RPM=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_SMD=y
CONFIG_SC_CAMCC_7280=y
CONFIG_SC_DISPCC_7280=y
CONFIG_SC_GCC_7280=y
CONFIG_SC_GPUCC_7280=y
CONFIG_SC_LPASS_CORECC_7280=y
CONFIG_SC_VIDEOCC_7280=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_QCOM_SPMI_ADC_TM5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_NVMEM_QCOM_QFPROM=y

# ath11k_ahb bootloops when built in on QCM6490 (needs SMEM after WPSS);
# shipped as a module and loaded after the WPSS remoteproc boots.
# The Luma phone image runs systemd-zram-generator and waits for zram0.
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
